<view class="page">
  <view class="intro muted">每家公司对应一个模板：卡片名称、币种、扫码模式和工资字段都在这里设置。</view>

  <view class="panel company-panel">
    <view
      wx:for="{{companies}}"
      wx:key="id"
      class="company {{item.disabled ? 'disabled' : ''}}"
      data-id="{{item.id}}"
      bindtap="openCompany"
    >
      <view class="swatch" style="background: linear-gradient(135deg, {{item.colorFrom}}, {{item.colorTo}});">{{item.currency}}</view>
      <view class="company-main">
        <view class="company-name">
          <text>{{item.name}}</text>
          <text wx:if="{{item.builtin}}" class="tag">内置</text>
          <text wx:if="{{item.disabled}}" class="tag muted-tag">已停用</text>
        </view>
        <view class="muted">{{item.modeName}} · {{item.count}} 条记录</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <button class="btn" bindtap="addCompany">+ 新增公司</button>
</view>
