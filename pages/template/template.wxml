<view class="page">
  <view class="format-tabs">
    <view
      wx:for="{{formatOptions}}"
      wx:key="id"
      class="format-tab {{format === item.id ? 'active' : ''}}"
      data-format="{{item.id}}"
      bindtap="changeFormat"
    >{{item.name}}</view>
  </view>

  <view class="panel" wx:for="{{sections}}" wx:key="group">
    <view class="section-title">{{item.title}}</view>
    <view wx:for="{{item.items}}" wx:for-item="field" wx:key="index" class="template-row">
      <input value="{{field}}" data-group="{{item.group}}" data-index="{{index}}" bindinput="updateName" />
    </view>
    <button class="btn secondary add-btn" data-group="{{item.group}}" bindtap="addField">添加字段</button>
  </view>

  <button class="btn warn reset-btn" bindtap="resetTemplate">重置为默认模板</button>
</view>
