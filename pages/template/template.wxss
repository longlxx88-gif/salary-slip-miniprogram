.intro {
  margin: 4rpx 8rpx 20rpx;
}

.company-panel {
  padding: 0 28rpx;
}

.company {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.company:last-child {
  border-bottom: none;
}

.company.disabled {
  opacity: 0.5;
}

.swatch {
  flex-shrink: 0;
  width: 112rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
}

.company-main {
  flex: 1;
  min-width: 0;
}

.company-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag {
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.tag.muted-tag {
  background: #eef1f5;
  color: var(--muted);
}

.arrow {
  color: #c2c8d0;
  font-size: 40rpx;
}
