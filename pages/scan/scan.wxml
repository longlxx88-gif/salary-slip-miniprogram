<view class="page">
  <view class="format-tabs">
    <view
      wx:for="{{formatOptions}}"
      wx:key="id"
      class="format-tab {{format === item.id ? 'active' : ''}}"
      data-format="{{item.id}}"
      bindtap="switchFormat"
    >{{item.name}}</view>
  </view>

  <block wx:if="{{!multiImage}}">
    <view class="panel preview-panel">
      <image wx:if="{{imagePath}}" class="preview" src="{{imagePath}}" mode="aspectFit" bindtap="previewImage"></image>
      <view wx:else class="placeholder" bindtap="chooseCamera">
        <view class="placeholder-icon">+</view>
        <view class="placeholder-title">拍摄或选择工资条</view>
        <view class="muted">请让工资条铺满画面、保持平整清晰</view>
      </view>
    </view>

    <view class="toolbar">
      <button class="btn secondary" bindtap="chooseCamera">拍照</button>
      <button class="btn secondary" bindtap="chooseAlbum">相册</button>
    </view>
  </block>

  <block wx:else>
    <view class="panel tip-panel">
      <view class="tip-title">上传“我的薪资”各页截图</view>
      <view class="tip-list">
        <view>· 请用手机截屏，不要拍屏幕</view>
        <view>· 可一次多选，最多 9 张</view>
        <view>· 重复的页面会自动合并</view>
      </view>
    </view>

    <view class="panel">
      <view class="thumb-header">
        <text class="section-title">已选截图</text>
        <text class="muted">{{imagePaths.length}} / 9</text>
      </view>
      <view class="thumb-grid">
        <view wx:for="{{imagePaths}}" wx:key="*this" class="thumb">
          <image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image>
          <view class="thumb-index">{{index + 1}}</view>
          <view class="thumb-remove" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
        <view wx:if="{{imagePaths.length < 9}}" class="thumb thumb-add" bindtap="chooseAlbum">
          <view class="thumb-add-icon">+</view>
          <view class="muted">添加截图</view>
        </view>
      </view>
    </view>
  </block>

  <button
    class="btn recognize"
    disabled="{{(multiImage ? !imagePaths.length : !imagePath) || recognizing}}"
    loading="{{recognizing}}"
    bindtap="recognize"
  >
    {{recognizing ? (progressText || '识别中') : '开始云端识别'}}
  </button>
  <view class="manual" bindtap="openManualReview">不识别，手动录入 ›</view>

  <canvas type="2d" id="cleanCanvas" class="compress-canvas" style="width: 10px; height: 10px;"></canvas>
  <canvas canvas-id="compressCanvas" class="compress-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
</view>
