<view class="page">
  <view class="toolbar">
    <button class="btn" bindtap="chooseCamera">拍照</button>
    <button class="btn secondary" bindtap="chooseAlbum">相册</button>
  </view>

  <view class="panel preview-panel">
    <image wx:if="{{imagePath}}" class="preview" src="{{imagePath}}" mode="aspectFit"></image>
    <view wx:else class="placeholder">选择工资条图片</view>
  </view>

  <button class="btn recognize" disabled="{{!imagePath || recognizing}}" loading="{{recognizing}}" bindtap="recognize">
    {{recognizing ? '识别中' : '开始云端识别'}}
  </button>
  <button class="btn secondary manual" bindtap="openManualReview">手动添加工资条</button>

  <canvas canvas-id="compressCanvas" class="compress-canvas" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
</view>
