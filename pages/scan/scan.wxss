.preview-panel {
  min-height: 760rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  width: 100%;
  height: 720rpx;
}

.placeholder {
  color: #6d7480;
}

.recognize {
  width: 100%;
}

.manual {
  width: 100%;
  margin-top: 16rpx;
}

.compress-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
