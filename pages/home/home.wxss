.home {
  /* 给右下角的新增按钮留出空间 */
  padding-bottom: 200rpx;
}

.wallet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 4rpx 32rpx;
}

.wallet-title {
  font-size: 56rpx;
  font-weight: 800;
}

/* 右下角圆形新增按钮，层级高于叠放的卡片 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 64rpx;
  z-index: 100;
  width: 112rpx;
  height: 112rpx;
  line-height: 106rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  font-size: 64rpx;
  font-weight: 300;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(23, 32, 51, 0.3);
}

/* ---------- 钱包卡片 ---------- */
.wallet {
  position: relative;
}

/* 卡片高 400rpx；叠放的卡片只露出顶部 120rpx，最后一张完整显示 */
.wallet-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  height: 400rpx;
  padding: 32rpx 36rpx;
  border-radius: 32rpx;
  color: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(23, 32, 51, 0.18);
}

.wallet-card.stacked {
  margin-bottom: -280rpx;
}

.wallet-card::before {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -120rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.wallet-card::after {
  content: '';
  position: absolute;
  left: -60rpx;
  bottom: -140rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.card-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 56rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-currency {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.card-strip-amount {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.9;
}

.card-body {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
}

.card-label {
  font-size: 24rpx;
  opacity: 0.75;
}

.card-amount {
  margin-top: 4rpx;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-all;
}

.card-bottom {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 30rpx;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.card-months {
  font-size: 26rpx;
  font-weight: 600;
}

.wallet-hint {
  margin-top: 32rpx;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}
