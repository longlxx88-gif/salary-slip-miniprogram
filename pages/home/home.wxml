<view class="page home">
  <view class="wallet-header">
    <view class="wallet-title">工资卡包</view>
  </view>

  <view class="wallet">
    <view
      wx:for="{{cards}}"
      wx:key="id"
      class="wallet-card {{index === cards.length - 1 ? 'front' : 'stacked'}}"
      style="background: linear-gradient(135deg, {{item.colorFrom}} 0%, {{item.colorTo}} 100%); z-index: {{index + 1}};"
      data-format="{{item.id}}"
      bindtap="openCard"
    >
      <view class="card-top">
        <text class="card-name">{{item.name}}</text>
        <text wx:if="{{index !== cards.length - 1}}" class="card-strip-amount num">{{item.symbol}} {{item.netText}}</text>
        <text wx:else class="card-currency">{{item.currency}}</text>
      </view>
      <view class="card-body">
        <view class="card-label">累计实发</view>
        <view class="card-amount num">{{item.symbol}} {{item.netText}}</view>
      </view>
      <view class="card-bottom">
        <text class="card-label">记录月份</text>
        <text class="card-months num">{{item.monthsText}}</text>
      </view>
    </view>
  </view>

  <view class="wallet-hint">点击卡片查看月度明细</view>

  <view class="fab" bindtap="goScan">+</view>
</view>
