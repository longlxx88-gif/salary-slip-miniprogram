<view class="page">
  <view class="panel">
    <view class="summary-grid">
      <view>
        <view class="muted">记录数</view>
        <view class="metric">{{summary.count}}</view>
      </view>
      <view>
        <view class="muted">累计实发</view>
        <view class="metric">¥{{summary.netText}}</view>
      </view>
      <view>
        <view class="muted">月均实发</view>
        <view class="metric">¥{{summary.avgNetText}}</view>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="filter-row">
      <picker mode="selector" range="{{yearOptions}}" bindchange="changeYear">
        <view class="picker">{{selectedYearText}}</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty">
    <view class="section-title">暂无工资记录</view>
    <view class="muted">点击“新增工资条”，可 OCR 识别，也可在里面手动添加并保存图片。</view>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="record">
    <view class="record-main">
      <view>
        <view class="record-month">{{item.month}}</view>
        <view class="muted">应发 ¥{{item.grossText}} · 扣除 ¥{{item.deductText}}</view>
      </view>
      <view class="record-net">¥{{item.netText}}</view>
    </view>
    <view class="record-actions">
      <button class="mini" data-id="{{item.id}}" bindtap="editRecord">编辑</button>
      <button class="mini" data-id="{{item.id}}" bindtap="rescanRecord">重拍覆盖</button>
      <button class="mini danger-text" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
    </view>
  </view>

  <button class="fab" bindtap="goScan">+</button>
</view>
