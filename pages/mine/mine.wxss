.mine-page {
  padding-bottom: 140rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1f7a68 0%, #4fb39e 100%);
  color: #fff;
  box-shadow: 0 18rpx 42rpx rgba(31, 122, 104, 0.18);
}

.profile-card .muted {
  color: rgba(255, 255, 255, 0.78);
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 42rpx;
  font-weight: 800;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.menu-panel {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-title {
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.arrow {
  color: #a2a9b3;
  font-size: 46rpx;
}
