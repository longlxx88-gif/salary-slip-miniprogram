<view class="page mine-page">
  <view class="profile-card">
    <view class="avatar">薪</view>
    <view>
      <view class="title">工资台账</view>
      <view class="subtitle">泰国 · 国内 双账本，云端自动备份</view>
    </view>
  </view>

  <view class="menu-group-title">数据</view>
  <view class="panel menu-panel">
    <view class="menu-item" bindtap="exportData">
      <view class="menu-icon icon-export">⇩</view>
      <view class="menu-text">
        <view class="menu-title">导出数据</view>
        <view class="muted">导出 Excel，每家公司一个工作表</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goTemplate">
      <view class="menu-icon icon-template">≡</view>
      <view class="menu-text">
        <view class="menu-title">模板管理</view>
        <view class="muted">新增公司、设置扫码模式与工资字段</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="menu-group-title">安全</view>
  <view class="panel menu-panel">
    <view class="menu-item" bindtap="goSettings">
      <view class="menu-icon icon-settings">☁</view>
      <view class="menu-text">
        <view class="menu-title">备份与隐私</view>
        <view class="muted">云备份、从云端恢复、访问密码</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>
</view>
