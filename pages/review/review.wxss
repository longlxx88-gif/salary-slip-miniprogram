.status-panel {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.field-label {
  font-weight: 700;
  margin-bottom: 12rpx;
}

.image-panel image {
  width: 100%;
  height: 420rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #f2f5f8;
}

.image-header {
  display: block;
}

.image-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.mini-action,
.mini-remove {
  min-height: 56rpx;
  line-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #eef2f5;
  color: #20242c;
  font-size: 24rpx;
}

.mini-remove {
  width: 100%;
  margin-top: 14rpx;
  color: #bc3b33;
}

.image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  margin-top: 18rpx;
  border: 2rpx dashed #cfd6df;
  border-radius: 8rpx;
  color: #6d7480;
  background: #f8fafc;
}

.field-row {
  grid-template-columns: minmax(0, 1fr) 240rpx;
  gap: 16rpx;
}

@media (max-width: 360px) {
  .field-row {
    grid-template-columns: minmax(0, 1fr) 200rpx;
  }
}

.mini-confirm {
  min-height: 56rpx;
  line-height: 56rpx;
  margin: 10rpx 0 0;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #bc3b33;
  color: #fff;
  font-size: 24rpx;
}

.bottom-actions {
  margin-top: 10rpx;
}

.save {
  width: 100%;
  margin-top: 10rpx;
}
