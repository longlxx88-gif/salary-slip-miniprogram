.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.range-chip {
  height: 60rpx;
  padding: 0 24rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 24rpx;
  box-shadow: var(--shadow);
}

.range-chip.active {
  background: var(--ink);
  color: #fff;
}

.range-save {
  margin-left: auto;
  color: var(--primary);
  font-size: 24rpx;
}

.summary-main {
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--line);
}

.summary-amount {
  margin: 4rpx 0;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-all;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-top: 24rpx;
}

.summary-cell {
  min-width: 0;
}

.metric {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-all;
}

.metric.deduct {
  color: var(--danger);
}

.chart-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.chart-picker {
  color: var(--primary);
  font-size: 24rpx;
}

.chart-tip {
  margin-top: 8rpx;
  text-align: center;
  color: var(--muted);
  font-size: 22rpx;
}

.chart {
  width: 100%;
  height: 420rpx;
}

.chart.tall {
  height: 540rpx;
}
