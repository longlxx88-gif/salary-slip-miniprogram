.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.metric {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.chart-title-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
}

.picker.compact {
  min-width: 180rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dbe0e7;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #20242c;
  text-align: center;
}

.chart-tip {
  margin-top: 10rpx;
  color: #6d7480;
  font-size: 24rpx;
}

.chart {
  width: 100%;
  height: 420rpx;
}

.chart.tall {
  height: 540rpx;
}
