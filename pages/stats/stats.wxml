<view class="page">
  <view class="format-tabs">
    <view
      wx:for="{{formatOptions}}"
      wx:key="id"
      class="format-tab {{format === item.id ? 'active' : ''}}"
      data-format="{{item.id}}"
      bindtap="changeFormat"
    >{{item.name}} · {{item.currency}}</view>
  </view>

  <view class="range-row">
    <view class="range-chip {{range === 'half' ? 'active' : ''}}" data-range="half" bindtap="changeRange">近半年</view>
    <view class="range-chip {{range === 'year' ? 'active' : ''}}" data-range="year" bindtap="changeRange">今年</view>
    <view class="range-chip {{range === 'all' ? 'active' : ''}}" data-range="all" bindtap="changeRange">全部</view>
    <view class="range-save" bindtap="saveCharts">保存图表</view>
  </view>

  <view class="panel summary-panel">
    <view class="summary-main">
      <view class="muted">累计实发</view>
      <view class="summary-amount num">{{symbol}} {{summary.netText}}</view>
      <view class="muted num">月均 {{symbol}} {{summary.avgNetText}}</view>
    </view>
    <view class="summary-grid">
      <view class="summary-cell">
        <view class="muted">累计应发</view>
        <view class="metric num">{{summary.grossText}}</view>
      </view>
      <view class="summary-cell">
        <view class="muted">累计扣除</view>
        <view class="metric num deduct">{{summary.deductText}}</view>
      </view>
      <view class="summary-cell">
        <view class="muted">月均应发</view>
        <view class="metric num">{{summary.avgGrossText}}</view>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="chart-title-row">
      <view class="section-title">{{chartName}}趋势</view>
      <picker mode="selector" range="{{chartOptions}}" value="{{chartIndex}}" bindchange="changeChartItem">
        <view class="chart-picker">切换 ▾</view>
      </picker>
    </view>
    <canvas canvas-id="lineChart" class="chart" bindtap="tapLineChart"></canvas>
    <view class="chart-tip">{{selectedPointText || '点击曲线上的点查看当月数值'}}</view>
  </view>

  <view class="panel">
    <view class="section-title">收入结构</view>
    <canvas canvas-id="pieChart" class="chart"></canvas>
  </view>

  <view class="panel">
    <view class="section-title">收入扣除对比</view>
    <canvas canvas-id="barChart" class="chart tall"></canvas>
  </view>
</view>
