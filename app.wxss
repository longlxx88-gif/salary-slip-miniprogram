/* ---------- 设计变量 ---------- */
page {
  --bg: #f3f5f8;
  --surface: #ffffff;
  --surface-2: #f6f8fa;
  --ink: #172033;
  --ink-2: #4a5468;
  --muted: #8a93a3;
  --line: #e8ecf1;
  --primary: #0f766e;
  --primary-strong: #0b5d57;
  --primary-soft: #e3f3f0;
  --danger: #d14343;
  --danger-soft: #fdecec;
  --warn: #b7791f;
  --warn-soft: #fff6e0;
  --thai: #0f766e;
  --thai-soft: #e3f3f0;
  --cn: #c2410c;
  --cn-soft: #fff0e8;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --shadow: 0 4rpx 24rpx rgba(23, 32, 51, 0.06);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx 48rpx;
}

/* ---------- 文本 ---------- */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.danger {
  color: var(--danger);
}

.num {
  font-variant-numeric: tabular-nums;
}

/* ---------- 卡片 ---------- */
.panel {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

/* ---------- 按钮 ---------- */
button::after {
  border: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
}

.btn.secondary {
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.btn.warn {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn[disabled] {
  background: #d5dbe3 !important;
  color: #fff !important;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.toolbar .btn {
  flex: 1;
  width: auto;
  min-width: 0;
}

/* ---------- 标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 600;
}

.format-tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--thai-soft);
  color: var(--thai);
}

.format-tag.tag-cn {
  background: var(--cn-soft);
  color: var(--cn);
}

/* ---------- 分段切换 ---------- */
.format-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #e6eaf0;
}

.format-tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-2);
}

/* 公司较多时可横向滚动 */
.format-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.format-tabs.scrollable {
  display: inline-flex;
  min-width: 100%;
  box-sizing: border-box;
  margin-bottom: 0;
}

.format-tabs.scrollable .format-tab {
  flex: 1 0 auto;
  padding: 0 28rpx;
}

.format-tab.active {
  background: var(--surface);
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(23, 32, 51, 0.08);
}

/* ---------- 表单 ---------- */
input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  padding: 0 22rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 28rpx;
}

.picker {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 26rpx;
  box-shadow: var(--shadow);
}

/* ---------- 字段行（校对页） ---------- */
.field-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240rpx;
  gap: 16rpx;
  align-items: start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field-row:last-child {
  border-bottom: none;
}

.field-row.pending {
  margin: 8rpx -16rpx;
  padding: 16rpx;
  border-bottom: none;
  border-radius: var(--radius-sm);
  background: var(--warn-soft);
  box-shadow: inset 6rpx 0 0 var(--warn);
}

.field-row.error {
  margin: 8rpx -16rpx;
  padding: 16rpx;
  border-bottom: none;
  border-radius: var(--radius-sm);
  background: var(--danger-soft);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 96rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  line-height: 120rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
}
